name: NPM Audit Endpoint Test

on:
  workflow_dispatch:

jobs:
  npm-audit-test:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Node
        uses: actions/setup-node@v4
        with:
          node-version: "22"

      - name: Show versions
        run: |
          node --version
          npm --version

      - name: Show configured registry
        run: npm config get registry

      - name: Install dependencies
        run: npm ci --ignore-scripts --audit=false

      - name: Run NPM Audit
        run: npm audit --json
        continue-on-error: true
